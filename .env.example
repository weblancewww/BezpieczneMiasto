# ---------------------------------------------------------------------------
# Wzorzec zmiennych środowiskowych. Skopiuj do `.env.docker` (compose) albo
# wklej wartości do panelu Coolify (Environment Variables).
#
# Ten plik NIE zawiera prawdziwych sekretów i jest celowo w repozytorium.
# ---------------------------------------------------------------------------

# --- Baza danych -----------------------------------------------------------
# Adres używany przez Prismę (aplikacja i CLI).
# W docker-compose host bazy to nazwa usługi, czyli `db`.
DATABASE_URL=mysql://bm_user:zmien_to_haslo@db:3306/bezpieczne_miasto

# Zmienne dla usługi `db` w docker-compose. Jeśli podasz komplet MYSQL_*,
# kontener aplikacji sam zbuduje z nich DATABASE_URL (patrz docker-entrypoint.sh).
MYSQL_ROOT_PASSWORD=zmien_to_haslo_root
MYSQL_DATABASE=bezpieczne_miasto
MYSQL_USER=bm_user
MYSQL_PASSWORD=zmien_to_haslo

# Baza pomocnicza — potrzebna tylko lokalnie dla `prisma migrate dev`.
# Produkcja używa `prisma db push`, więc ta zmienna nie jest wymagana.
SHADOW_DATABASE=shadow_bezpieczne_miasto

# --- Uwierzytelnianie (NextAuth v5) ---------------------------------------
# Wygeneruj nowy sekret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET=wygeneruj_nowy_sekret
AUTH_SECRET=wygeneruj_nowy_sekret
# Publiczny adres aplikacji (z https) — bez tego logowanie przekieruje źle.
NEXTAUTH_URL=https://twoja-domena.pl
AUTH_TRUST_HOST=true

# --- Google Maps -----------------------------------------------------------
# UWAGA: zmienna NEXT_PUBLIC_* jest wbudowywana w aplikację NA ETAPIE BUDOWANIA.
# W Coolify oznacz ją jako "Build Variable", inaczej mapa nie pojawi się w UI.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=twoj_klucz_google_maps

# Opcjonalnie: osobny klucz dla statycznych map w mailach (jeśli nie podano,
# używany jest NEXT_PUBLIC_GOOGLE_MAPS_API_KEY).
GOOGLE_MAPS_STATIC_API_KEY=

# --- Poczta (opcjonalnie) --------------------------------------------------
# Konfiguracja maili jest trzymana w bazie i ustawiana w panelu
# (Ustawienia -> Konfiguracja poczty). Poniższe zmienne to tylko wartości
# startowe, używane dopóki w bazie nie ma zapisanej konfiguracji.
SMTP_HOST=s167.cyber-folks.pl
SMTP_PORT=587
SMTP_USER=devs@weblance.pl
SMTP_PASSWORD=
SMTP_FROM=Bezpieczne Miasto <devs@weblance.pl>

# --- Trwały storage (docker-compose) ---------------------------------------
# Katalogi na dysku hosta dla bazy i uploadów.
MARIADB_DATA_DIR=./.docker-data/bezpieczne-miasto/mariadb
UPLOADS_DATA_DIR=./.docker-data/bezpieczne-miasto/uploads
